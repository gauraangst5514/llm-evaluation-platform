# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# PostgreSQL (used by the db service in docker-compose and by the API)
POSTGRES_USER=llmeval
POSTGRES_PASSWORD=llmeval
POSTGRES_DB=llmeval
POSTGRES_PORT=5432

# API
API_PORT=8000
# Inside Compose the API reaches the db service by its name. For a local
# (non-Docker) API, use localhost instead of db.
DATABASE_URL=postgresql+asyncpg://llmeval:llmeval@db:5432/llmeval

# Hugging Face token: only needed for gated datasets (MILU, FLORES). Leave empty otherwise.
HF_TOKEN=

# Web
WEB_PORT=5173

# Model servers run OUTSIDE Compose. Register them via POST /models with their URL,
# e.g. http://host.docker.internal:8080 for a llama-server on this Mac.
